{
  "name": "saleshiker-mobile-qa",
  "version": "1.0.0",
  "private": true,
  "description": "SalesHiker Android UI test automation: Appium (UiAutomator2) + WebdriverIO + Mocha + Chai in TypeScript",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "wdio run ./config/wdio.android.conf.ts",
    "test:smoke": "wdio run ./config/wdio.android.conf.ts --suite smoke",
    "test:regression": "wdio run ./config/wdio.android.conf.ts --suite regression",
    "report": "node tools/allure/build-report.mjs",
    "report:html": "node tools/html/build-report.mjs",
    "report:monocart": "node tools/monocart/build-report.mjs",
    "reports": "node tools/allure/build-report.mjs && node tools/html/build-report.mjs && node tools/monocart/build-report.mjs",
    "excel": "node tools/excel/update-workbooks.js",
    "docs:framework": "node tools/docs/framework-overview.mjs",
    "docs:framework:check": "node tools/docs/framework-overview.mjs --check",
    "docs:watch": "node tools/docs/framework-overview.mjs --watch"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/junit-reporter": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.1.0",
    "allure-commandline": "^2.46.1",
    "chai": "^6.3.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "lodash": "^4.18.1",
    "monocart-reporter": "^2.15.1",
    "typescript": "^7.0.2",
    "wdio-html-nice-reporter": "^8.1.7",
    "webdriverio": "^10.1.0"
  }
}
