# Copy this file to config\.env and fill in local values.
# config\.env is git-ignored. Never commit real credentials.
# Any value can also be overridden by setting an environment variable of the same name.

# ---- App under test
APP_ID=com.saleshiker.app
# Absolute path to the APK to install (scripts\install-apk.ps1)
APK_PATH=

# ---- Emulator
AVD_NAME=SalesHiker_API35
# Hardware profile from: avdmanager list device -c
AVD_DEVICE=pixel_7
# Must already be installed under %ANDROID_HOME%\system-images. google_apis (no Play Store)
# is much lighter than google_apis_playstore on 4-core hosts.
AVD_SYSTEM_IMAGE=system-images;android-35;google_apis;x86_64
# Optional folder for the AVD's disk images (default: %USERPROFILE%\.android\avd)
AVD_DIR=
# Emulator hardware, applied on every start. Lower these on machines with < 16 GB RAM.
AVD_CORES=4
AVD_RAM_MB=4096
# host = hardware GPU (fast); swiftshader_indirect = software fallback if the window stays black
AVD_GPU_MODE=host
# Comma-separated system packages disabled on the emulator after boot (crash/CPU noise).
# Undo with: adb shell pm enable <package>
AVD_DISABLE_PACKAGES=com.google.android.googlequicksearchbox

# ---- Test data (passed to flows as MAESTRO_* variables; see test-data\README.md)
TEST_USERNAME=
TEST_PASSWORD=

# Device to test on (adb serial). Empty = the only connected device (emulator or phone).
DEVICE_SERIAL=

# 1 = reuse the UiAutomator2 server already on the device instead of (re)installing it.
# Needed on phones that hold adb installs behind a "risky app" prompt (ColorOS, MIUI).
SKIP_SERVER_INSTALL=
